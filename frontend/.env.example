VITE_KAKAO_MAP_KEY=your_kakao_javascript_key_here
# 로컬 개발에서는 비워 두면 /api 요청이 Vite 프록시를 통해 localhost:8080으로 전달됩니다.
# 운영에서는 실제 백엔드 주소(예: https://api.mannayeok.kr)를 설정해야 합니다.
VITE_BACKEND_API_URL=
# 인증 API만 별도 주소를 사용할 때 설정합니다. 없으면 VITE_BACKEND_API_URL을 사용합니다.
VITE_AUTH_API_BASE_URL=http://localhost:8080

# 관리자 메뉴에서 문의 관리 Google Sheet를 새 탭으로 여는 주소입니다.
# 시트 자체는 비공개로 유지하고 관리자 Google 계정에만 공유하세요.
VITE_ADMIN_INQUIRY_SHEET_URL=
