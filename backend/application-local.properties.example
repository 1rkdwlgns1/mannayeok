# Copy this file to application-local.properties and replace every CHANGE_ME value.
# application-local.properties is ignored by Git and is only for local development.

spring.datasource.url=jdbc:mysql://localhost:3306/mannayeok?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=mannayeok_local
spring.datasource.password=CHANGE_ME_DB_PASSWORD

app.auth.jwt-secret=CHANGE_ME_WITH_A_FIXED_SECRET_OF_AT_LEAST_32_BYTES
app.auth.admin-secondary.verification-minutes=15
app.cors.allowed-origins=http://localhost:5173
app.features.collaborative-meetings-enabled=false

app.auth.password-reset.enabled=true
app.auth.password-reset.frontend-base-url=http://localhost:5173
app.auth.password-reset.token-minutes=30
app.auth.password-reset.cooldown-seconds=60
spring.mail.username=mannayeok.help@gmail.com
spring.mail.password=CHANGE_ME_GMAIL_APP_PASSWORD_WITHOUT_SPACES
app.auth.password-reset.mail-from=mannayeok.help@gmail.com

app.auth.kakao.client-id=CHANGE_ME_KAKAO_REST_API_KEY
app.auth.kakao.client-secret=CHANGE_ME_KAKAO_CLIENT_SECRET
app.auth.kakao.admin-key=CHANGE_ME_KAKAO_ADMIN_KEY
app.auth.kakao.redirect-uri=http://localhost:8080/api/auth/oauth/kakao/callback
app.auth.kakao.frontend-base-url=http://localhost:5173

app.auth.naver.client-id=CHANGE_ME_NAVER_CLIENT_ID
app.auth.naver.client-secret=CHANGE_ME_NAVER_CLIENT_SECRET
app.auth.naver.redirect-uri=http://localhost:8080/api/auth/oauth/naver/callback
app.auth.naver.frontend-base-url=http://localhost:5173
