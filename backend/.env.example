SUBWAY_API_SERVICE_KEY=your_public_data_decoding_service_key
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_MOBILITY_KEY=your_kakao_mobility_key
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173
COLLABORATIVE_MEETINGS_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_PROXY_REQUESTS=120
RATE_LIMIT_PROXY_WINDOW_SECONDS=60
RATE_LIMIT_SHARE_CREATE_REQUESTS=20
RATE_LIMIT_SHARE_CREATE_WINDOW_SECONDS=3600

# MySQL은 회원, 가입 동의 및 비밀번호 재설정 토큰 저장에 필요합니다.
DB_URL=jdbc:mysql://localhost:3306/mannayeok?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=mannayeok
DB_PASSWORD=change_me
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TOKEN_MINUTES=120
JWT_ISSUER=mannayeok
ADMIN_VERIFICATION_MINUTES=15

# 비밀번호 재설정 메일. 로컬에서 메일 발송을 사용하지 않으면 false로 둡니다.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mannayeok.help@gmail.com
MAIL_PASSWORD=replace_with_gmail_app_password
MAIL_FROM=mannayeok.help@gmail.com
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

KAKAO_OAUTH_CLIENT_ID=replace_with_kakao_rest_api_key
KAKAO_OAUTH_CLIENT_SECRET=replace_with_kakao_client_secret
KAKAO_ADMIN_KEY=replace_with_kakao_admin_key
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/oauth/kakao/callback

NAVER_OAUTH_CLIENT_ID=replace_with_naver_client_id
NAVER_OAUTH_CLIENT_SECRET=replace_with_naver_client_secret
NAVER_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/oauth/naver/callback
